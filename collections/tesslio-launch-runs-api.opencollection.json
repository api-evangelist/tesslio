            "headers": [
              {
                "name": "Authorization",
                "value": "Bearer <token>"
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Gets a launch run by ID, including progress while pending and a failure reason when failed."
        },
        {
          "info": {
            "name": "GET /experimental/launch-runs/{id}/logs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tessl.io/experimental/launch-runs/:id/logs",
            "headers": [
              {
                "name": "Authorization",
                "value": "Bearer <token>"
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns the raw provider JSONL transcript for a launch run's agent logs. Serves the most recently captured session as a single transcript; `204 No Content` means no session has been uploaded (or its upload has not completed) yet."
