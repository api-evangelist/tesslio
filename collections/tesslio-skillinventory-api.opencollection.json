                "name": "workspaceNameOrID",
                "value": "",
                "type": "path"
              },
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns the authenticated header row for a workspace-scoped skill inventory."
        },
        {
          "info": {
            "name": "DELETE /v1/workspaces/{workspaceNameOrID}/skill-inventories/{id}",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.tessl.io/v1/workspaces/:workspaceNameOrID/skill-inventories/:id",
            "headers": [
              {
                "name": "Authorization",
                "value": "Bearer <token>"
              }
            ],
            "params": [
              {
                "name": "workspaceNameOrID",
                "value": "",
                "type": "path"
              },
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Deletes a workspace-scoped skill inventory. Requires the `manage_integrations` permission (workspace manager or owner). The delete is a soft delete: the inventory and all its scans become inaccessible, but the org can be re-scanned later. Idempotent — deleting an already-deleted or unknown inventory returns 404."
        },
        {
          "info": {
            "name": "GET /v1/workspaces/{workspaceNameOrID}/skill-inventories/{id}/github-app-status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tessl.io/v1/workspaces/:workspaceNameOrID/skill-inventories/:id/github-app-status",
